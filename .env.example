# === Deployment domain (drives docker-compose.yml nginx + frontend build args) ===
# Set to your registrable domain. The production compose derives:
#   app.<DOMAIN>   → SPA (apps/app)         build arg VITE_API_BASE_URL=https://api.<DOMAIN>
#   api.<DOMAIN>   → API (apps/api)
DOMAIN=yourdomain.com

# === App (build-time) ===
# VITE_API_BASE_URL is derived from DOMAIN by docker-compose.yml
# (https://api.<DOMAIN>) — no need to set it here for production.

# === API (runtime) ===
NODE_ENV=production
PORT=3000
# If using TLS, prefer explicit sslmode=verify-full over require/prefer —
# pg v9 will downgrade those aliases to weaker non-verifying libpq semantics.
DATABASE_URL=postgresql://user:password@host:5432/dbname
ACCESS_TOKEN_SECRET=changeme_generate_a_random_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=changeme_generate_a_different_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d
JWT_ISSUER=https://api.yourdomain.com
JWT_AUDIENCE=https://app.yourdomain.com
LOG_LEVEL=info
LOG_TO_FILE=false
# Must list the SPA origin exactly (credentialed CORS — no wildcard).
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GENERAL_MAX=100
