# === Deployment domain (drives docker-compose.yml nginx + frontend build args) ===
# Set to your registrable domain. The production compose derives:
#   app.<DOMAIN>   → SPA (apps/app)         build arg VITE_API_BASE_URL=https://api.<DOMAIN>
#   api.<DOMAIN>   → API (apps/api)
DOMAIN=yourdomain.com

# === App (build-time) ===
# VITE_API_BASE_URL is derived from DOMAIN by docker-compose.yml
# (https://api.<DOMAIN>) — no need to set it here for production.

# === API (runtime) ===
# With docker-compose.local.yml (plain HTTP on localhost) set NODE_ENV=development.
# The API marks the auth cookies Secure only in production, and browsers reject
# Secure cookies over HTTP — leaving this at "production" silently breaks sign-in
# on the local stack. That stack also wants JWT_ISSUER and JWT_AUDIENCE set to
# http://localhost, plus CORS_ALLOWED_ORIGINS and APP_BASE_URL on http://localhost.
NODE_ENV=production
PORT=3000
# If using TLS, prefer explicit sslmode=verify-full over require/prefer —
# pg v9 will downgrade those aliases to weaker non-verifying libpq semantics.
# With docker-compose.local.yml the database runs in the stack — the hostname is
# the compose service name, not localhost:
# DATABASE_URL=postgresql://pg_user:pg_password@postgres:5432/fullstack_template
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Redis is required, not an optional cache: BullMQ has no in-memory driver, so
# without it notification jobs are accepted and never run. The production compose
# ships no redis service — point this at a managed instance (prefer rediss:// for TLS).
# With docker-compose.local.yml Redis runs in the stack — the hostname is the compose
# service name, never localhost (inside the api container localhost is the API process
# itself):
# REDIS_URL=redis://redis:6379
REDIS_URL=redis://user:password@host:6379
ACCESS_TOKEN_SECRET=changeme_generate_a_random_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=changeme_generate_a_different_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d
# The audience is the service that validates the token — the API, not the SPA.
JWT_ISSUER=https://api.yourdomain.com
JWT_AUDIENCE=https://api.yourdomain.com
LOG_LEVEL=info
# Must list the SPA origin exactly (credentialed CORS — no wildcard).
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
# Public base URL of the SPA — the base of every invitation accept link
# (<APP_BASE_URL>/invite/<id>?token=...). MUST be set in production: the
# built-in default is http://localhost:8080, which yields unusable links.
# local dev: http://localhost:8080 · local Docker: http://localhost
APP_BASE_URL=https://app.yourdomain.com
# Requests per 15-minute window per IP, counted in Redis — the limit is shared across
# replicas, not multiplied by them. AUTH is a stricter override on /auth/* (max 50).
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GENERAL_MAX=1000

# Nightly cron that prunes expired auth rows and dead invitations, in bounded
# batches under a Postgres advisory lock so replicas never duplicate the work.
# Defaults to true. Set false only if an external job owns this.
# CLEANUP_ENABLED=true

# Days to keep audit log entries (positive integer)
AUDIT_RETENTION_DAYS=90

# OpenAPI spec + Swagger UI at /api/docs. Left unset on purpose: the default is
# false when NODE_ENV=production and true otherwise, which is right in every
# environment. Setting it overrides that derivation — an uncommented "true"
# copied into a production .env publishes the whole route and schema surface.
# SWAGGER_ENABLED=true
