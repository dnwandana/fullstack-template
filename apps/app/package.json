{
  "name": "@fullstack/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --force",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@fullstack/contracts": "workspace:*",
    "ant-design-vue": "^4.2.6",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-oxlint": "~1.85.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.85.0",
    "prettier": "3.9.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
