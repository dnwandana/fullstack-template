# Test environment template — copy to .env.test and adjust DATABASE_URL.
#   cp .env.test.example .env.test
# Unlike .env.example, every value here is valid: the app boots from this file as-is.

NODE_ENV=test
PORT=3000

# Point at a SEPARATE database. The e2e suite runs `prisma migrate deploy` against it
# and TRUNCATEs every table between tests.
DATABASE_URL=postgresql://pg_user:pg_password@localhost:5432/fullstack_template_test

# Dummy secrets — valid (32+ chars, distinct, no "changeme" prefix) but not secret.
ACCESS_TOKEN_SECRET=test_access_secret_do_not_use_in_production_0001
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=test_refresh_secret_do_not_use_in_production_0002
REFRESH_TOKEN_EXPIRES_IN=7d
JWT_ISSUER=http://localhost
JWT_AUDIENCE=http://localhost

# Database 1, not the default 0: integration specs write and flush keys, and pointing
# them at db 0 would evict whatever the developer's local .env is using.
REDIS_URL=redis://localhost:6379/1

LOG_LEVEL=info

CORS_ALLOWED_ORIGINS=http://localhost:8080
APP_BASE_URL=http://localhost:8080

# Headroom so the suite never trips its own limits.
# 50 is the Joi ceiling (env.validation.ts caps RATE_LIMIT_AUTH_MAX at 50) —
# it is the highest legal value, not an arbitrary large number. The throttle
# bucket is per-handler per spec-file app instance; the heaviest suite
# (invitations.e2e-spec) uses ~21 signups+signins ≈ 42% of this budget. If a
# suite starts 429ing, split the spec file rather than raising the limit.
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_GENERAL_MAX=100000
