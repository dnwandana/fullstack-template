# application
NODE_ENV=development
PORT=3000

# database
# If using TLS, prefer explicit sslmode=verify-full over require/prefer —
# pg v9 will downgrade those aliases to weaker non-verifying libpq semantics.
DATABASE_URL=postgresql://pg_user:pg_password@pg_host/pg_database

# JWT — generate random secrets (min 32 chars). ACCESS and REFRESH must differ.
# Token lifetimes. Grammar is <number><s|m|h|d> — "1w" is rejected on purpose, because
# the JWT, the refresh_tokens row, and the cookie maxAge all parse this same value.
ACCESS_TOKEN_SECRET=changeme_generate_a_random_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=changeme_generate_a_different_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=https://api.example.com

# logging
LOG_LEVEL=info

# maintenance
# Daily 3am pruning of expired refresh/reset tokens and invitations.
# Safe to leave on with multiple replicas — the job takes a Postgres advisory lock.
CLEANUP_ENABLED=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080

# public base URL of the frontend SPA — used to build invitation accept links
# local:      http://localhost:8080
# docker dev: http://localhost
# production: https://app.yourdomain.com   (MUST be set — the default is wrong in prod)
APP_BASE_URL=http://localhost:8080

# rate limiting
# Requests per 15 minutes per IP.
# GENERAL applies to every route; AUTH is a stricter override on /auth/* (max 50).
# Both counters live in process memory: with N replicas the effective limit is N x this.
RATE_LIMIT_GENERAL_MAX=1000
RATE_LIMIT_AUTH_MAX=10

# api docs
# Serve Swagger UI at /api/docs. Left commented on purpose: unset means "true outside
# production, false in production", which is what you want in every environment. Setting it
# overrides that derivation — an uncommented SWAGGER_ENABLED=true copied into a production
# .env publishes the whole route and schema surface regardless of NODE_ENV.
# SWAGGER_ENABLED=true
