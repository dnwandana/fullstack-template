{
  "name": "@fullstack/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-unit.json",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json --runInBand --coverage",
    "migrate:dev": "prisma migrate dev && prisma generate",
    "prisma:pull": "prisma db pull",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "nest build && prisma db seed",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@fullstack/contracts": "workspace:*",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "oxlint": "~1.85.0",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.8",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
