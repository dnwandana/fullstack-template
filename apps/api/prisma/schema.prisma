generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @db.Uuid
  name                String    @db.VarChar(100)
  email               String    @unique(map: "users_email_unique") @db.VarChar(255)
  password            String    @db.VarChar(255)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitationsReceived  Invitation[]         @relation("InvitationInvitee")
  invitationsSent      Invitation[]         @relation("InvitationInviter")
  orgMembers           OrgMember[]
  organizationsCreated Organization[]
  passwordResetTokens  PasswordResetToken[]
  projectMembers       ProjectMember[]
  projectsCreated      Project[]
  refreshTokens        RefreshToken[]
  todos                Todo[]

  @@map("users")
}

model Organization {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  auditLogs   AuditLog[]
  creator     User         @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "organizations_created_by_foreign")
  invitations Invitation[]
  orgMembers  OrgMember[]
  projects    Project[]
  roles       Role[]

  @@map("organizations")
}

model Permission {
  id          String   @id @db.Uuid
  name        String   @unique(map: "permissions_name_unique") @db.VarChar(100)
  description String?
  resource    String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([resource, action], map: "permissions_resource_action_unique")
  @@map("permissions")
}

// Role names are also case-insensitively unique per org via the SQL-only functional
// index roles_org_id_lower_name_unique on (org_id, lower(name)) in the migration —
// Prisma cannot model functional indexes. The plain @@unique below stays for
// compound-key queries.
model Role {
  id          String   @id @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(50)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "roles_org_id_foreign")
  invitations     Invitation[]
  orgMembers      OrgMember[]
  projectMembers  ProjectMember[]
  rolePermissions RolePermission[]

  @@unique([orgId, name], map: "roles_org_id_name_unique")
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_permission_id_foreign")
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_role_id_foreign")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OrgMember {
  userId   String   @map("user_id") @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  roleId   String   @map("role_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "org_members_org_id_foreign")
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "org_members_role_id_foreign")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "org_members_user_id_foreign")

  @@id([userId, orgId])
  @@map("org_members")
}

model Project {
  id          String   @id @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitations    Invitation[]
  projectMembers ProjectMember[]
  creator        User            @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "projects_created_by_foreign")
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "projects_org_id_foreign")
  todos          Todo[]

  @@map("projects")
}

model ProjectMember {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_members_project_id_foreign")
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "project_members_role_id_foreign")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_members_user_id_foreign")

  @@id([userId, projectId])
  @@map("project_members")
}

// Partial unique indexes on pending invitations
// (invitations_pending_org_email_unique, invitations_pending_project_email_unique)
// exist only in the migration SQL — Prisma cannot model partial indexes.
enum InvitationStatus {
  pending
  accepted
  declined
}

model Invitation {
  id           String           @id @db.Uuid
  orgId        String           @map("org_id") @db.Uuid
  projectId    String?          @map("project_id") @db.Uuid
  inviterId    String           @map("inviter_id") @db.Uuid
  inviteeEmail String?          @map("invitee_email") @db.VarChar(255)
  inviteeId    String?          @map("invitee_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  status       InvitationStatus @default(pending)
  tokenHash    String?          @unique(map: "invitations_token_hash_unique") @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitee      User?        @relation("InvitationInvitee", fields: [inviteeId], references: [id], onUpdate: NoAction, map: "invitations_invitee_id_foreign")
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onUpdate: NoAction, map: "invitations_inviter_id_foreign")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invitations_org_id_foreign")
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invitations_project_id_foreign")
  role         Role         @relation(fields: [roleId], references: [id], onUpdate: NoAction, map: "invitations_role_id_foreign")

  @@index([expiresAt], map: "invitations_expires_at_index")
  @@index([inviteeEmail], map: "invitations_invitee_email_index")
  @@index([inviteeId], map: "invitations_invitee_id_index")
  @@index([orgId], map: "invitations_org_id_index")
  @@index([status, expiresAt], map: "invitations_status_expires_at_index")
  @@map("invitations")
}

model Todo {
  id          String   @id @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  isCompleted Boolean  @default(false) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "todos_project_id_foreign")
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "todos_user_id_foreign")

  @@index([projectId], map: "todos_project_id_index")
  @@index([projectId, userId], map: "todos_project_id_user_id_index")
  @@map("todos")
}

model RefreshToken {
  // All IDs are app-generated crypto.randomUUID() (v4) — refresh-token.service.ts
  // always supplies the id, so the old gen_random_uuid() DB default was dead code.
  // UUIDv7 is the upgrade path if B-tree locality on this hot table ever matters.
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_user_id_foreign")

  @@index([expiresAt], map: "refresh_tokens_expires_at_index")
  @@index([revokedAt], map: "refresh_tokens_revoked_at_index")
  @@index([tokenHash], map: "refresh_tokens_token_hash_index")
  @@index([userId], map: "refresh_tokens_user_id_index")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_unique") @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_reset_tokens_user_id_foreign")

  @@index([expiresAt], map: "password_reset_tokens_expires_at_index")
  @@index([userId], map: "password_reset_tokens_user_id_index")
  @@map("password_reset_tokens")
}

// Append-only: no updatedAt (precedent: Permission). The org FK cascades — the org
// page is the log's only entry point, so the log dies with the org. actor_id and
// entity_id carry no FK: a removed user or deleted entity keeps its trail, with the
// *_name columns as display snapshots so the UI never joins.
model AuditLog {
  id         String   @id @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  projectId  String?  @map("project_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name")
  actorEmail String?  @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  entityName String   @map("entity_name")
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "audit_logs_org_id_foreign")

  @@index([orgId, createdAt], map: "audit_logs_org_id_created_at_index")
  @@index([orgId, projectId, createdAt], map: "audit_logs_org_id_project_id_created_at_index")
  @@map("audit_logs")
}
