generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @db.Uuid
  name                String    @db.VarChar(100)
  email               String    @unique(map: "users_email_unique") @db.VarChar(255)
  password            String    @db.VarChar(255)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitationsReceived  Invitation[]    @relation("InvitationInvitee")
  invitationsSent      Invitation[]    @relation("InvitationInviter")
  orgMembers           OrgMember[]
  organizationsCreated Organization[]
  projectMembers       ProjectMember[]
  projectsCreated      Project[]
  refreshTokens        RefreshToken[]
  todos                Todo[]

  @@map("users")
}

model Organization {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator     User         @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "organizations_created_by_foreign")
  invitations Invitation[]
  orgMembers  OrgMember[]
  projects    Project[]
  roles       Role[]

  @@map("organizations")
}

model Permission {
  id          String   @id @db.Uuid
  name        String   @unique(map: "permissions_name_unique") @db.VarChar(100)
  description String?
  resource    String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([resource, action], map: "permissions_resource_action_unique")
  @@map("permissions")
}

model Role {
  id          String   @id @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(50)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "roles_org_id_foreign")
  invitations     Invitation[]
  orgMembers      OrgMember[]
  projectMembers  ProjectMember[]
  rolePermissions RolePermission[]

  @@unique([orgId, name], map: "roles_org_id_name_unique")
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_permission_id_foreign")
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_role_id_foreign")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OrgMember {
  userId   String   @map("user_id") @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  roleId   String   @map("role_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "org_members_org_id_foreign")
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "org_members_role_id_foreign")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "org_members_user_id_foreign")

  @@id([userId, orgId])
  @@map("org_members")
}

model Project {
  id          String   @id @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitations    Invitation[]
  projectMembers ProjectMember[]
  creator        User            @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "projects_created_by_foreign")
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "projects_org_id_foreign")
  todos          Todo[]

  @@map("projects")
}

model ProjectMember {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_members_project_id_foreign")
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_members_role_id_foreign")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_members_user_id_foreign")

  @@id([userId, projectId])
  @@map("project_members")
}

model Invitation {
  id           String   @id @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  projectId    String?  @map("project_id") @db.Uuid
  inviterId    String   @map("inviter_id") @db.Uuid
  inviteeEmail String?  @map("invitee_email") @db.VarChar(255)
  inviteeId    String?  @map("invitee_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  status       String   @default("pending") @db.VarChar(20)
  tokenHash    String?  @unique(map: "invitations_token_hash_unique") @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitee      User?        @relation("InvitationInvitee", fields: [inviteeId], references: [id], onUpdate: NoAction, map: "invitations_invitee_id_foreign")
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onUpdate: NoAction, map: "invitations_inviter_id_foreign")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invitations_org_id_foreign")
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invitations_project_id_foreign")
  role         Role         @relation(fields: [roleId], references: [id], onUpdate: NoAction, map: "invitations_role_id_foreign")

  @@index([inviteeEmail], map: "invitations_invitee_email_index")
  @@index([inviteeId], map: "invitations_invitee_id_index")
  @@index([orgId], map: "invitations_org_id_index")
  @@index([status, expiresAt], map: "invitations_status_expires_at_index")
  @@map("invitations")
}

model Todo {
  id          String   @id @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?
  isCompleted Boolean  @default(false) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "todos_project_id_foreign")
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "todos_user_id_foreign")

  @@index([projectId], map: "todos_project_id_index")
  @@index([projectId, userId], map: "todos_project_id_user_id_index")
  @@map("todos")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_user_id_foreign")

  @@index([tokenHash], map: "refresh_tokens_token_hash_index")
  @@index([userId], map: "refresh_tokens_user_id_index")
  @@map("refresh_tokens")
}
