{
  "$schema": "https://v2-10-4.turborepo.dev/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "DATABASE_URL",
        "ACCESS_TOKEN_SECRET",
        "REFRESH_TOKEN_SECRET",
        "ACCESS_TOKEN_EXPIRES_IN",
        "REFRESH_TOKEN_EXPIRES_IN",
        "JWT_ISSUER",
        "JWT_AUDIENCE",
        "NODE_ENV",
        "PORT",
        "LOG_LEVEL",
        "CORS_ALLOWED_ORIGINS",
        "APP_BASE_URL",
        "RATE_LIMIT_AUTH_MAX",
        "RATE_LIMIT_GENERAL_MAX"
      ]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "ACCESS_TOKEN_SECRET",
        "REFRESH_TOKEN_SECRET",
        "ACCESS_TOKEN_EXPIRES_IN",
        "REFRESH_TOKEN_EXPIRES_IN",
        "JWT_ISSUER",
        "JWT_AUDIENCE",
        "NODE_ENV",
        "PORT",
        "LOG_LEVEL",
        "CORS_ALLOWED_ORIGINS",
        "APP_BASE_URL",
        "RATE_LIMIT_AUTH_MAX",
        "RATE_LIMIT_GENERAL_MAX"
      ]
    },
    "format": {
      "outputs": []
    }
  }
}
